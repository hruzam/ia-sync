# ia-sync .gitignore — second guard (sync.sh is the primary allowlist filter)

# Secrets (should never arrive via sync.sh, but belt-and-suspenders)
.env/
*secret*
*credential*
*.credentials.*

# Logs and runtime
*.log
*.lock

# Conversation/session data (should not arrive, but guard anyway)
*.jsonl
*.db
*.db-wal
*.db-shm
*.pb

# Binary / generated artefacts
bin/
brain/
conversations/
cache/
updater/
builtin/
knowledge/
implicit/
__pycache__/

# Claude project session data (not synced by sync.sh) — anchored to repo root
/projects/

# Gemini runtime state (machine-specific)
gemini/config/projects/
file-history/
paste-cache/

# Tunnel vault state (machine-local runtime — MUST NOT travel between hosts).
# These carry `enabled: true` plus a live threadId: syncing one hands the other host
# a pre-armed table it never opened, bypassing Law 2.4, and lets it spend quota on a
# thread it does not own. Same class as *.jsonl rollouts above — runtime, not config.
# The tunnel PRESET REGISTRY (zsh/registries/tunnel.json) is config and DOES travel.
# Scoped deliberately: `tunnel*.state.json`, NOT a bare `*.state.json`. The broad form
# would silently swallow any future <anything>.state.json anywhere in the tree — a file
# you meant to track would just never appear. Audit the reach of any widening with:
#   git ls-files | git check-ignore --stdin --no-index -v
tunnel*.state.json
downloads/
tmp/
history/

# Never commit bare config.zsh — always use config.<host>.zsh
zsh/config.zsh
zsh/secrets.zsh

# Mail bus — ephemeral, non-canonical (Cinderella rule)
_mail/*/archive

# ~/.majkee leg — process data never committed (majkee.deny is the primary guard)
/majkee/export/
/majkee/cooking-recipes/
!devices/_shared/termux/bin/
