{
 "permissions": {
  "allow": [
   "Read",
   "Edit",
   "Write",
   "Agent",
   "Task",
   "Bash(echo:*)"
  ]
 },
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/tmp/muticula-b0-claude-Blhz7x/tools/logger.py layer-flag"
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "/tmp/muticula-b0-claude-Blhz7x/tools/logger.py pre"
     }
    ]
   },
   {
    "matcher": "Edit|Write|MultiEdit|NotebookEdit",
    "hooks": [
     {
      "type": "command",
      "command": "/tmp/muticula-b0-claude-Blhz7x/tools/guard.py healthy",
      "timeout": 2
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "/tmp/muticula-b0-claude-Blhz7x/tools/logger.py post"
     }
    ]
   }
  ]
 },
 "disableAllHooks": true
}