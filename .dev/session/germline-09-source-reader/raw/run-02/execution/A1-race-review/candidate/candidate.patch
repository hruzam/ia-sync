+    original_root, original_run = adapter.B, adapter.R
+    adapter.B, adapter.R = transition_root, run
+    try:
+        adapter.compile_packets(['R1', 'A1'], [])
+        c1 = files['frozen_plan']
+        c1_bytes = c1.read_bytes()
+        operations = files['operations']; operations.mkdir(parents=True, exist_ok=True)
+        packet = run / 'packets/R1.md'
+        ask_bytes = {}
+        for number in range(2):
+            receipt = operations / f'preserved{number}.operation.json'
+            dump(receipt, {'kind': 'ask', 'status': 'completed', 'exit': 0,
+                           'outputs': {channel: {'path': str(packet), 'sha256': digest(packet)}
+                                       for channel in ('stdout', 'stderr')}})
+            ask_bytes[receipt] = receipt.read_bytes()
+        revised = adapter.load(run / 'CONTRACT.json')
+        c2 = run / 'caretaker/plan.C2.json'
+        revised['files']['frozen_plan'] = str(c2)
+        dump(run / 'CONTRACT.json', revised)
+        rotated_pins = adapter.load(files['pins'])
+        rotated_pins['future_plan'] = str(c2)
+        dump(files['pins'], rotated_pins)
+        assert not c2.exists()
+        adapter.compile_packets(['R2', 'A2'], [])
+        c = adapter.contract()
+        assert c['files']['frozen_plan'] == str(c2)
