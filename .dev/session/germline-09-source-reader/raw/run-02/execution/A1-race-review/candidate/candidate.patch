+        assert c1.read_bytes() == c1_bytes
+        assert all(path.read_bytes() == before for path, before in ask_bytes.items())
+        assert adapter.ask_count(c) == 2
+    finally:
+        adapter.B, adapter.R = original_root, original_run
+
