# Use powerline
USE_POWERLINE="true"
# Source manjaro-zsh-configuration
if [[ -e /usr/share/zsh/manjaro-zsh-config ]]; then
  source /usr/share/zsh/manjaro-zsh-config
fi
# Use manjaro zsh prompt
if [[ -e /usr/share/zsh/manjaro-zsh-prompt ]]; then
  source /usr/share/zsh/manjaro-zsh-prompt
fi

# =============================================================================
# TEMPORARY
# =============================================================================
# Full ritual, discipline-ordered: pull --rebase → DEPLOY (repo→live, so a behind
# machine levels up first) → sync (live→repo, now contributes only genuine novelty)
# → status. Deploy-before-sync is a hard precondition (journal 2026-07-28) — a sync
# from a stale machine --deletes the other side's skills/commands out of the repo.
alias zsync='cd ~/ia-sync && git pull --rebase origin main && bash deploy.sh && bash sync.sh && git status'

# =============================================================================
# PROJECT SWITCHER SYSTEM
# Sources config.zsh → project-switcher.zsh → monitoring → system utilities
# After this block: php74, php8, phpst, imst, fost, fo, im, art, all toolkits
# =============================================================================
[[ -f ~/.config/zsh/config.zsh ]]           && source ~/.config/zsh/config.zsh
[[ -f ~/.config/zsh/project-switcher.zsh ]] && source ~/.config/zsh/project-switcher.zsh
[[ -f ~/.config/zsh/git-lifecycle.zsh ]]    && source ~/.config/zsh/git-lifecycle.zsh


# =============================================================================
# LOCAL ALIASES (not synced — credentials or office-only one-offs)
# =============================================================================

# Git stash utilities
alias patch='git stash show "stash@{0}" -p > changes.patch'
alias gpt='git stash show -p stash@{0} > temp.patch'

# Database quick access
alias dbup='mysql -u root -p'
alias dbfo="fo && /usr/bin/mariadb -u majkee -p fantasyobchod"
alias dbps="fo && /usr/bin/mariadb -u majkee -p psdvs"

# Heureka cron file (FO)
alias heu="fo && subl -a cron/heureka-ostra.xml"

# virtual desktop — switch to desktop N and run command
dsk() {
  local desk=$1
  shift
  wmctrl -s "$desk" && "$@"
}

#generate hash (12numbers)
alias hasz="openssl rand -hex 6"

# ========================
# temporary FREYA aliases
# ========================

alias gpl="git pull && npm run build && php artisan optimize:clear"
alias mig="time php artisan migrate:fresh --seed"
alias freya="cd /home/hruzam/www/imago_cz/freya"
alias dbfr="freya && /usr/bin/mariadb -u majkee -p freya"


# =============================================================================
# PATH
# =============================================================================
export PATH=~/.npm-global/bin:$PATH
export PATH="$HOME/.local/bin:$PATH"
