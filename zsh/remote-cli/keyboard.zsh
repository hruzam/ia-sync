# remote-cli control panel — aliases and comments only.
# Bodies: remote-cli.sh · convention: ../guides/guide-for-builder.md
alias remote-fit='_remote_cli fit'       # size follows the most recently active client
alias remote-wide='_remote_cli wide'     # size follows the largest attached client
alias remote-scroll='_remote_cli scroll' # session mouse scrolling and history floor
alias remote-status='_remote_cli status' # window sizing, mouse and scrollback state
alias remote-help='_remote_cli help'     # usage and existing connection doors
