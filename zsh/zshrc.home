# Use powerline
USE_POWERLINE="true"
# Source manjaro-zsh-configuration
if [[ -e /usr/share/zsh/manjaro-zsh-config ]]; then
  source /usr/share/zsh/manjaro-zsh-config
fi
# Use manjaro zsh prompt
if [[ -e /usr/share/zsh/manjaro-zsh-prompt ]]; then
  source /usr/share/zsh/manjaro-zsh-prompt
fi

# =============================================================================
# TEMPORARY
# =============================================================================
# Current compose-first receive path: pull → deploy → status. The retired sync.sh
# harvest leg must never run from this key (SYNC_DISCIPLINE.md, 2026-07-31).
alias zsync='cd ~/ia-sync && git pull --rebase origin main && bash deploy.sh && git status'

# -----------------------------------------------------------------------------
# Dual-boot NTFS dirty-flag workaround (2026-08-28). Windows Fast Startup leaves
# sda4 (Pikczurouni) / sda5 (Data_M2) marked dirty; ntfs3 then refuses to mount.
# Read-only + force by default — writing while dirty risks Windows clobbering
# changes on hibernation resume. Remove this block once Fast Startup is off
# and a clean Windows shutdown has cleared the dirty flag for good.
ntfs-dirty-mount() {
  sudo mkdir -p /run/media/hruzam/Pikczurouni /run/media/hruzam/Data_M2
  sudo mount -t ntfs3 -o force,ro /dev/sda4 /run/media/hruzam/Pikczurouni && echo "mounted Pikczurouni (ro)"
  sudo mount -t ntfs3 -o force,ro /dev/sda5 /run/media/hruzam/Data_M2 && echo "mounted Data_M2 (ro)"
}

# Explicit write access — only use once you accept the hibernation-clobber risk
# (see journal / mail 2026-08-28 for the full explanation).
ntfs-dirty-mount-rw() {
  sudo mkdir -p /run/media/hruzam/Pikczurouni /run/media/hruzam/Data_M2
  sudo mount -t ntfs3 -o force /dev/sda4 /run/media/hruzam/Pikczurouni && echo "mounted Pikczurouni (rw, force)"
  sudo mount -t ntfs3 -o force /dev/sda5 /run/media/hruzam/Data_M2 && echo "mounted Data_M2 (rw, force)"
}

ntfs-dirty-umount() {
  sudo umount /run/media/hruzam/Pikczurouni 2>/dev/null && echo "unmounted Pikczurouni"
  sudo umount /run/media/hruzam/Data_M2 2>/dev/null && echo "unmounted Data_M2"
}

# =============================================================================
# PROJECT SWITCHER SYSTEM
# Sources config.zsh → project-switcher.zsh → git-lifecycle
# After this block: fo, im, psd, all toolkits per machine config
# NOTE: env-sync.zsh deliberately NOT sourced — deprecated 2026-06-30, archived.
# The 471-line pre-harness monolith this file replaced lives at
# archive/zshrc.home.legacy-2026-07-30.zsh (password REDACTED — see journal).
# =============================================================================
[[ -f ~/.config/zsh/config.zsh ]]           && source ~/.config/zsh/config.zsh
[[ -f ~/.config/zsh/project-switcher.zsh ]] && source ~/.config/zsh/project-switcher.zsh
[[ -f ~/.config/zsh/git-lifecycle.zsh ]]    && source ~/.config/zsh/git-lifecycle.zsh

# =============================================================================
# LOCAL ALIASES (home)
# =============================================================================

# Git stash utilities
alias patch='git stash show "stash@{0}" -p > changes.patch'
alias gpt='git stash show -p stash@{0} > temp.patch'

# Database quick access
alias dbup='mysql -u root -p'
alias dbfo="fo && /usr/bin/mariadb -u majkee -p fantasyobchod"

# generate hash (12 chars)
alias hasz='openssl rand -hex 6'

# save terminal history snapshot
alias svt='mkdir -p ~/log && history -i >> ~/log/_terminal.txt'

# virtual desktop — switch to desktop N and run command
dsk() {
  local desk=$1
  shift
  wmctrl -s "$desk" && "$@"
}

#generate hash (12numbers)
alias hasz="openssl rand -hex 6"

# ========================
# temporary FREYA aliases
# ========================

alias gpl="git pull && npm run build && php artisan optimize:clear"
alias mig="time php artisan migrate:fresh --seed"
alias freya="cd /home/hruzam/www/imago_cz/freya"
alias dbfr="freya && /usr/bin/mariadb -u majkee -p freya"

# =============================================================================
# PATH
# =============================================================================
export PATH=~/.npm-global/bin:$PATH
export PATH="$HOME/.local/bin:$PATH"
